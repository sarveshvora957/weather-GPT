# WeatherGPT Environment Configuration (SIH 2026)

# Server Port
PORT=3000

# Supabase Cloud Integration (Optional - app includes in-memory resilient fallback)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Google Gemini API Key for customized LLM persona reasoning
# Note: WeatherGPT includes a deterministic meteorological reasoning engine
# and functions 100% free without requiring any API keys.
GEMINI_API_KEY=

# Optional OpenWeatherMap API Key for additional layer telemetry
OPENWEATHER_API_KEY=

# NextAuth / JWT Secret (Optional)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Demo Mode active by default
NEXT_PUBLIC_DEMO_MODE=true
